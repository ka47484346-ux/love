
import streamlit as st
import streamlit.components.v1 as components

st.set_page_config(
    page_title="벽돌 깨기",
    page_icon="🧱",
    layout="centered"
)

st.title("🧱 벽돌 깨기")
st.caption("← → 방향키로 패들을 움직이세요!")

game = """
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">

<style>
    body {
        margin: 0;
        background: #111827;
        font-family: Arial, sans-serif;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 620px;
        overflow: hidden;
    }

    #gameContainer {
        text-align: center;
        color: white;
    }

    canvas {
        background: #0f172a;
        border: 3px solid #64748b;
        border-radius: 10px;
        box-shadow: 0 0 25px rgba(0,0,0,0.5);
    }

    #info {
        margin-bottom: 10px;
        font-size: 18px;
    }

    button {
        margin-top: 12px;
        padding: 10px 22px;
        border: none;
        border-radius: 8px;
        background: #3b82f6;
        color: white;
        font-size: 16px;
        cursor: pointer;
    }

    button:hover {
        background: #2563eb;
    }
</style>
</head>

<body>

<div id="gameContainer">

    <div id="info">
        점수: <span id="score">0</span>
        &nbsp;&nbsp;|&nbsp;&nbsp;
        목숨: <span id="lives">3</span>
    </div>

    <canvas id="gameCanvas" width="500" height="550"></canvas>

    <br>

    <button onclick="restartGame()">🔄 다시 시작</button>

</div>

<script>

const canvas = document.getElementById("gameCanvas");
const ctx = canvas.getContext("2d");

const scoreText = document.getElementById("score");
const livesText = document.getElementById("lives");

// 공
let ball = {
    x: canvas.width / 2,
    y: canvas.height - 60,
    dx: 4,
    dy: -4,
    radius: 8
};

// 패들
let paddle = {
    width: 90,
    height: 12,
    x: canvas.width / 2 - 45,
    speed: 8
};

// 벽돌
const brickRows = 5;
const brickCols = 8;
const brickWidth = 50;
const brickHeight = 20;
const brickPadding = 10;
const brickOffsetTop = 50;
const brickOffsetLeft = 20;

let bricks = [];

function createBricks() {
    bricks = [];

    for (let r = 0; r < brickRows; r++) {
        bricks[r] = [];

        for (let c = 0; c < brickCols; c++) {
            bricks[r][c] = {
                x: 0,
                y: 0,
                alive: true
            };
        }
    }
}

let score = 0;
let lives = 3;

let rightPressed = false;
let leftPressed = false;

let gameOver = false;
let gameWon = false;


// 키보드
document.addEventListener("keydown", function(e) {

    if (e.key === "ArrowRight") {
        rightPressed = true;
        e.preventDefault();
    }

    if (e.key === "ArrowLeft") {
        leftPressed = true;
        e.preventDefault();
    }

});

document.addEventListener("keyup", function(e) {

    if (e.key === "ArrowRight") {
        rightPressed = false;
    }

    if (e.key === "ArrowLeft") {
        leftPressed = false;
    }

});


// 공 그리기
function drawBall() {

    ctx.beginPath();

    ctx.arc(
        ball.x,
        ball.y,
        ball.radius,
        0,
        Math.PI * 2
    );

    ctx.fillStyle = "#f8fafc";
    ctx.fill();

    ctx.closePath();
}


// 패들 그리기
function drawPaddle() {

    ctx.beginPath();

    ctx.roundRect(
        paddle.x,
        canvas.height - 30,
        paddle.width,
        paddle.height,
        6
    );

    ctx.fillStyle = "#3b82f6";
    ctx.fill();

    ctx.closePath();
}


// 벽돌 그리기
function drawBricks() {

    for (let r = 0; r < brickRows; r++) {

        for (let c = 0; c < brickCols; c++) {

            if (!bricks[r][c].alive)
                continue;

            let brickX =
                c * (brickWidth + brickPadding)
                + brickOffsetLeft;

            let brickY =
                r * (brickHeight + brickPadding)
                + brickOffsetTop;

            bricks[r][c].x = brickX;
            bricks[r][c].y = brickY;

            ctx.beginPath();

            ctx.roundRect(
                brickX,
                brickY,
                brickWidth,
                brickHeight,
                4
            );

            ctx.fillStyle =
                r % 2 === 0
                ? "#f43f5e"
                : "#f59e0b";

            ctx.fill();

            ctx.closePath();
        }
    }
}


// 충돌 검사
function collisionDetection() {

    let remaining = 0;

    for (let r = 0; r < brickRows; r++) {

        for (let c = 0; c < brickCols; c++) {

            let brick = bricks[r][c];

            if (!brick.alive)
                continue;

            remaining++;

            if (
                ball.x > brick.x &&
                ball.x < brick.x + brickWidth &&
                ball.y > brick.y &&
                ball.y < brick.y + brickHeight
            ) {

                ball.dy = -ball.dy;

                brick.alive = false;

                score += 10;

                scoreText.textContent = score;
            }
        }
    }

    if (remaining === 0) {
        gameWon = true;
    }
}


// 공 이동
function moveBall() {

    if (gameOver || gameWon)
        return;

    ball.x += ball.dx;
    ball.y += ball.dy;


    // 왼쪽 / 오른쪽 벽
    if (
        ball.x + ball.radius > canvas.width ||
        ball.x - ball.radius < 0
    ) {
        ball.dx = -ball.dx;
    }


    // 위쪽 벽
    if (ball.y - ball.radius < 0) {
        ball.dy = -ball.dy;
    }


    // 패들 충돌
    const paddleY = canvas.height - 30;

    if (
        ball.y + ball.radius >= paddleY &&
        ball.y + ball.radius <= paddleY + paddle.height &&
        ball.x >= paddle.x &&
        ball.x <= paddle.x + paddle.width &&
        ball.dy > 0
    ) {

        ball.dy = -Math.abs(ball.dy);

        // 패들의 어느 위치에 맞았는지에 따라 방향 변경
        let hitPosition =
            (ball.x - paddle.x) / paddle.width;

        ball.dx = (hitPosition - 0.5) * 10;
    }


    // 공이 아래로 떨어짐
    if (ball.y - ball.radius > canvas.height) {

        lives--;

        livesText.textContent = lives;

        if (lives <= 0) {

            gameOver = true;

        } else {

            resetBall();

        }
    }
}


// 공 리셋
function resetBall() {

    ball.x = canvas.width / 2;
    ball.y = canvas.height - 60;

    ball.dx = 4 * (Math.random() > 0.5 ? 1 : -1);
    ball.dy = -4;
}


// 패들 이동
function movePaddle() {

    if (rightPressed) {

        paddle.x += paddle.speed;

    } else if (leftPressed) {

        paddle.x -= paddle.speed;
    }


    if (paddle.x < 0) {
        paddle.x = 0;
    }

    if (paddle.x + paddle.width > canvas.width) {
        paddle.x = canvas.width - paddle.width;
    }
}


// 메시지
function drawMessage() {

    if (!gameOver && !gameWon)
        return;

    ctx.fillStyle = "rgba(15,23,42,0.85)";

    ctx.fillRect(
        0,
        0,
        canvas.width,
        canvas.height
    );

    ctx.textAlign = "center";

    ctx.fillStyle = "white";

    ctx.font = "bold 38px Arial";

    if (gameWon) {

        ctx.fillText(
            "🎉 YOU WIN!",
            canvas.width / 2,
            canvas.height / 2 - 20
        );

        ctx.font = "20px Arial";

        ctx.fillText(
            "모든 벽돌을 깼어요!",
            canvas.width / 2,
            canvas.height / 2 + 25
        );

    } else {

        ctx.fillText(
            "GAME OVER",
            canvas.width / 2,
            canvas.height / 2 - 20
        );

        ctx.font = "20px Arial";

        ctx.fillText(
            "다시 시작해보세요!",
            canvas.width / 2,
            canvas.height / 2 + 25
        );
    }
}


// 게임 화면
function draw() {

    ctx.clearRect(
        0,
        0,
        canvas.width,
        canvas.height
    );

    drawBricks();
    drawBall();
    drawPaddle();

    collisionDetection();
    moveBall();
    movePaddle();

    drawMessage();

    requestAnimationFrame(draw);
}


// 다시 시작
function restartGame() {

    score = 0;
    lives = 3;

    scoreText.textContent = score;
    livesText.textContent = lives;

    gameOver = false;
    gameWon = false;

    paddle.x =
        canvas.width / 2 - paddle.width / 2;

    resetBall();
    createBricks();
}


// 시작
createBricks();
draw();

</script>

</body>
</html>
"""

components.html(game, height=620)
